<MudChip T="string" Size="Size.Small" Color="ChipColor" Variant="Variant.Text">@DisplayStatus</MudChip>

@code {
    [Parameter] public string? Status { get; set; }
    private string DisplayStatus => string.IsNullOrWhiteSpace(Status) ? "unknown" : Status;
    private Color ChipColor => Status?.ToLowerInvariant() switch
    {
        "open" or "connected" => Color.Success,
        "connecting" or "retrying" or "generatingqr" => Color.Warning,
        _ => Color.Default
    };
}
