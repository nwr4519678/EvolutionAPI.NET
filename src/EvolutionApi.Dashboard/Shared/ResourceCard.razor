<MudPaper Class="resource-card" Elevation="0"><MudIcon Icon="@Icon" Color="Color.Primary" Size="Size.Large" /><div><MudText Typo="Typo.h6">@Title</MudText><MudText Typo="Typo.body2" Class="muted-text">@Text</MudText>@if (RequiresAdminKey) { <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="mt-3" Icon="@Icons.Material.Filled.Lock">Protected · admin key required</MudChip> } else { <MudButton Href="@Href" Target="_blank" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">Open resource <MudIcon Icon="@Icons.Material.Filled.ArrowOutward" Size="Size.Small" /></MudButton> }</div></MudPaper>
@code { [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Info; [Parameter] public string Title { get; set; } = string.Empty; [Parameter] public string Text { get; set; } = string.Empty; [Parameter] public string Href { get; set; } = "#"; [Parameter] public bool RequiresAdminKey { get; set; } }
