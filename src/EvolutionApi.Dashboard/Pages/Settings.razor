@page "/settings"
@inject DashboardState State
@inject EvolutionApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Settings · Evolution Control</PageTitle>
<div class="page-heading"><div><MudText Typo="Typo.h4">Dashboard settings</MudText><MudText Class="muted-text">Connect this WebAssembly dashboard to your gateway.</MudText></div></div>
<MudGrid Spacing="3"><MudItem xs="12" md="7"><MudPaper Class="panel-card" Elevation="0"><MudText Typo="Typo.h6">Gateway access</MudText><MudText Typo="Typo.body2" Class="muted-text mt-1">The key stays in app memory until you refresh or close this tab. Use HTTPS in production.</MudText><MudTextField @bind-Value="_apiKey" Label="Global API key" InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-4" /><MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save connection</MudButton><MudButton Class="mt-4 ml-2" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@_testing" OnClick="TestConnection">@(_testing ? "Testing…" : "Test connection")</MudButton></MudPaper></MudItem><MudItem xs="12" md="5"><MudPaper Class="panel-card" Elevation="0"><MudText Typo="Typo.h6">Security notes</MudText><MudList T="string" Dense="true"><MudListItem T="string" Icon="@Icons.Material.Filled.Security">Never share the global key or put it in a URL.</MudListItem><MudListItem T="string" Icon="@Icons.Material.Filled.Cloud">Keep the dashboard behind the same TLS boundary as the API.</MudListItem><MudListItem T="string" Icon="@Icons.Material.Filled.AdminPanelSettings">Use instance keys for operational messaging.</MudListItem></MudList></MudPaper></MudItem></MudGrid>

@code {
    private string _apiKey = string.Empty;
    private bool _testing;
    protected override void OnInitialized() => _apiKey = State.ApiKey;
    private void Save() { State.SetApiKey(_apiKey); Snackbar.Add("Gateway key saved for this session", Severity.Success); }
    private async Task TestConnection()
    {
        Save();
        _testing = true;
        try
        {
            var instances = await Api.GetInstancesAsync();
            Snackbar.Add($"Gateway connection is working. {instances.Count} instance(s) found.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _testing = false; }
    }
}
