@page "/settings"
@inject DashboardState State
@inject EvolutionApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Manager access · Evolution Control</PageTitle>
<div class="page-heading"><div><MudText Typo="Typo.h4">Manager access</MudText><MudText Class="muted-text">Sign in to manage client instances and view resource usage.</MudText></div></div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <MudPaper Class="panel-card" Elevation="0">
            @if (State.IsManagerAuthenticated)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">Manager session active</MudChip>
                <MudText Typo="Typo.body2" Class="muted-text mt-4">The gateway API key stays on the dashboard server. Your browser uses a short-lived, HTTP-only manager session cookie.</MudText>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@_testing" OnClick="TestConnection">@(_testing ? "Checking…" : "Check gateway connection")</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="Logout">Sign out</MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.h6">Manager sign in</MudText>
                <MudText Typo="Typo.body2" Class="muted-text mt-1">Use the manager password configured on the dashboard server.</MudText>
                <MudTextField @bind-Value="_password" Label="Manager password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mt-4" OnKeyDown="HandleKeyDown" />
                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_signingIn" OnClick="Login">@(_signingIn ? "Signing in…" : "Sign in")</MudButton>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudPaper Class="panel-card" Elevation="0">
            <MudText Typo="Typo.h6">Manager controls</MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.Key">Client API keys are generated automatically for each WhatsApp number.</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Security">The master gateway key is stored server-side and is never sent to the browser.</MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.Lock">Manager sessions expire after eight hours; production must use HTTPS.</MudListItem>
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _password = string.Empty;
    private bool _signingIn;
    private bool _testing;

    private async Task Login()
    {
        if (string.IsNullOrWhiteSpace(_password))
        {
            Snackbar.Add("Enter the manager password.", Severity.Warning);
            return;
        }

        _signingIn = true;
        try
        {
            if (!await Api.LoginManagerAsync(_password))
            {
                Snackbar.Add("Manager password is incorrect.", Severity.Error);
                return;
            }
            State.SetManagerAuthenticated(true);
            _password = string.Empty;
            Snackbar.Add("Signed in as manager.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _signingIn = false; }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await Login();
    }

    private async Task TestConnection()
    {
        _testing = true;
        try
        {
            var instances = await Api.GetInstancesAsync();
            Snackbar.Add($"Gateway connection is healthy. {instances.Count} client instance(s) found.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _testing = false; }
    }

    private async Task Logout()
    {
        try
        {
            await Api.LogoutManagerAsync();
            State.SetManagerAuthenticated(false);
            Snackbar.Add("Signed out.", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
