@page "/settings"
@using EvolutionApi.Dashboard.Services
@inject AppState State
@inject ISnackbar Snackbar

<div class="page-container">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Platform & Tenant Settings</h1>
            <p class="page-subtitle">Configure regional localization, theming preferences, and security policies</p>
        </div>
        <div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Save"
                       OnClick="SaveSettings"
                       Style="border-radius: 9999px; text-transform: none; font-weight: 600;">
                Save Changes
            </MudButton>
        </div>
    </div>

    <!-- Tabbed Settings -->
    <div class="glass-card mt-6">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="p-6">
            <!-- General Tab -->
            <MudTabPanel Text="General & Localization" Icon="@Icons.Material.Rounded.Tune">
                <div class="settings-form-grid">
                    <MudTextField @bind-Value="_companyName"
                                  Label="Tenant / Platform Name"
                                  Variant="Variant.Outlined" />

                    <MudSelect @bind-Value="_timezone"
                               Label="Default Timezone"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("UTC")">UTC (Coordinated Universal Time)</MudSelectItem>
                        <MudSelectItem Value="@("America/New_York")">America/New_York (EST / EDT)</MudSelectItem>
                        <MudSelectItem Value="@("Europe/London")">Europe/London (GMT / BST)</MudSelectItem>
                        <MudSelectItem Value="@("Europe/Berlin")">Europe/Berlin (CET / CEST)</MudSelectItem>
                        <MudSelectItem Value="@("Asia/Dubai")">Asia/Dubai (GST +4)</MudSelectItem>
                        <MudSelectItem Value="@("Asia/Riyadh")">Asia/Riyadh (AST +3)</MudSelectItem>
                        <MudSelectItem Value="@("Africa/Cairo")">Africa/Cairo (EET +2)</MudSelectItem>
                    </MudSelect>

                    <MudSelect @bind-Value="_language"
                               Label="Default Interface Language"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("en")">English (EN)</MudSelectItem>
                        <MudSelectItem Value="@("ar")">العربية (Arabic - RTL)</MudSelectItem>
                        <MudSelectItem Value="@("es")">Español (Spanish)</MudSelectItem>
                        <MudSelectItem Value="@("pt")">Português (Portuguese)</MudSelectItem>
                    </MudSelect>

                    <div class="mt-4">
                        <MudSwitch Value="@State.IsDarkMode"
                                   ValueChanged="@((bool dark) => State.SetTheme(dark))"
                                   Color="Color.Primary"
                                   Label="Dark Theme Mode (Recommended for Luxury Aesthetics)" />
                    </div>
                </div>
            </MudTabPanel>

            <!-- Security & Quota Tab -->
            <MudTabPanel Text="Security & Limits" Icon="@Icons.Material.Rounded.Security">
                <div class="settings-form-grid">
                    <MudNumericField @bind-Value="_rateLimitPerMinute"
                                     Label="Default Inbound Rate Limit (Messages / Minute / Contact)"
                                     Variant="Variant.Outlined"
                                     Min="1" Max="120" />

                    <MudNumericField @bind-Value="_monthlyTokenQuota"
                                     Label="Monthly AI Token Quota Limit"
                                     Variant="Variant.Outlined"
                                     Min="10000" Step="50000" />

                    <div class="mt-4">
                        <MudSwitch @bind-Value="_enforce2Fa"
                                   Color="Color.Primary"
                                   Label="Enforce Two-Factor Authentication (2FA) for All Client Admins" />
                    </div>
                </div>
            </MudTabPanel>

            <!-- Notifications Tab -->
            <MudTabPanel Text="Notifications" Icon="@Icons.Material.Rounded.Notifications">
                <div class="settings-form-grid">
                    <MudCheckBox @bind-Value="_notifyOnSessionDrop" Label="Alert when any WhatsApp session disconnects" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_notifyOnQuotaExceeded" Label="Alert when monthly AI token budget reaches 90%" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="_notifyOnHumanHandoff" Label="Alert agents immediately when customer requests human handover" Color="Color.Primary" />
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
</div>

@code {
    private string _companyName = "Platform Operations";
    private string _timezone = "UTC";
    private string _language = "en";
    private int _rateLimitPerMinute = 15;
    private long _monthlyTokenQuota = 1000000;
    private bool _enforce2Fa = true;
    private bool _notifyOnSessionDrop = true;
    private bool _notifyOnQuotaExceeded = true;
    private bool _notifyOnHumanHandoff = true;

    protected override void OnInitialized()
    {
        if (State.SelectedTenant != null)
        {
            _companyName = State.SelectedTenant.Name;
            _timezone = State.SelectedTenant.Timezone;
            _language = State.SelectedTenant.Language;
        }
    }

    private void SaveSettings()
    {
        Snackbar.Add("Settings saved and cached to memory store", Severity.Success);
    }
}
