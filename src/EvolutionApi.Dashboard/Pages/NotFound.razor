@page "/404"
@page "/notfound"

<div class="empty-state" style="min-height: 60vh;">
    <div class="empty-state-icon" style="background: rgba(244,63,94,0.12); color: var(--color-accent-rose);">
        <MudIcon Icon="@Icons.Material.Rounded.SearchOff" Size="Size.Large" />
    </div>
    <div class="empty-state-title">Page Not Found</div>
    <div class="empty-state-description">
        The requested resource or page could not be located. It might have been moved, renamed, or you may not have permission to view it.
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Class="mt-4"
               StartIcon="@Icons.Material.Rounded.ArrowBack"
               Style="border-radius: 9999px; text-transform: none; font-weight: 600;">
        Back to Overview
    </MudButton>
</div>

