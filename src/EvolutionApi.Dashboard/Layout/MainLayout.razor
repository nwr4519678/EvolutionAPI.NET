@using EvolutionApi.Dashboard.Services
@using EvolutionApi.Dashboard.Theme
@inject AppState AppState
@inject RealtimeService Realtime
@inject NavigationManager Nav
@implements IDisposable

<MudLayout>
    @if (AppState.IsAuthenticated)
    {
        <div class="app-frame">
        <!-- Premium Sidebar -->
        <AppSidebar />

        <!-- Top Bar -->
        <AppTopBar />

        <!-- Main Content -->
        <MudMainContent Class="@GetMainClass()">
            <div class="page-wrapper page-enter">
                <CascadingValue Value="this">
                    @Body
                </CascadingValue>
            </div>
        </MudMainContent>
        </div>
    }
    else
    {
        @Body
    }
</MudLayout>

@code {
    [Parameter] public RenderFragment? Body { get; set; }

    protected override void OnInitialized()
    {
        AppState.OnChange += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Connect to SignalR for real-time updates
        try { await Realtime.ConnectAsync(); }
        catch { /* graceful degradation - real-time features won't be available */ }
    }

    private string GetMainClass() =>
        $"main-content {(AppState.SidebarCollapsed ? "sidebar-collapsed" : "")}";

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => AppState.OnChange -= OnStateChanged;
}

