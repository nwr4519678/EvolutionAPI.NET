<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\EvolutionApi.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Force Workstation GC to aggressively minimize RAM on MonsterASP -->
          <environmentVariable name="DOTNET_gcServer" value="0" />
        </environmentVariables>
      </aspNetCore>
      <!-- Enable WebSockets for Baileys WhatsApp Engine & SignalR Hubs -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering>
          <!-- 50MB upload limit to handle WhatsApp media (audio, documents, video) without IIS 413 error -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
