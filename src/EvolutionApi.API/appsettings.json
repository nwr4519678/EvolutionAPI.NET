{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=EvolutionApi;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiDocumentation": {
    "Enabled": false
  },
  "Dashboard": {
    "AllowedOrigins": [
      "http://localhost:5160",
      "https://localhost:7292"
    ]
  },
  "RateLimiting": {
    "ApiPermitLimit": 200,
    "ApiWindowMinutes": 1,
    "ApiSegmentsPerWindow": 6,
    "MessagePermitLimit": 30,
    "MessageWindowMinutes": 1,
    "MessageSegmentsPerWindow": 6,
    "InstancePermitLimit": 10,
    "InstanceWindowMinutes": 1
  }
}
